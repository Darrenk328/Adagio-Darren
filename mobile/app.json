{
  "expo": {
    "name": "Adagio",
    "slug": "adagio",
    "scheme": "adagio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.darrenkapturski.Adagio",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Adagio uses Apple Music to match songs to your running cadence."
      }
    },
    "android": {
      "package": "com.adagio.app"
    },
    "plugins": ["./plugins/withGarminCadence.js"]
  }
}
